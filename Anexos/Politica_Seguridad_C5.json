{
  "version": 1,
  "profile": "C5 A/B",
  "owner": "Equipo de diseño de Financiera Pacífico",
  "services": {
    "app": "10.70.200.10",
    "database": "10.70.200.11",
    "pbx": "10.70.200.20",
    "dns": "10.70.200.30",
    "aaa": "10.70.200.31",
    "nms": "10.70.200.40",
    "backup": "10.70.200.50",
    "admin": "10.80.0.10"
  },
  "rules": [
    {
      "id": "ALLOW-CLUSTER-CONTROL",
      "action": "allow",
      "from": "Hosts 10.80.0.11 y 10.80.0.12",
      "to": "El otro host del clúster",
      "service": "UDP 5405–5412; TCP 22 y 60000–60050",
      "control": "Firewall de hipervisores y gestión",
      "reason": "Corosync, réplica ZFS y migración solo entre hosts autorizados."
    },
    {
      "id": "ALLOW-CLUSTER-WITNESS",
      "action": "allow",
      "from": "Hosts 10.80.0.11 y 10.80.0.12",
      "to": "BKP-01 10.70.200.50",
      "service": "TCP 5403",
      "control": "ACL de gestión, firewall central y host BKP",
      "reason": "Voto qdevice del clúster de dos nodos."
    },
    {
      "id": "ALLOW-CLUSTER-BACKUP",
      "action": "allow",
      "from": "Hosts 10.80.0.11 y 10.80.0.12",
      "to": "BKP-01 10.70.200.50",
      "service": "TCP 8007",
      "control": "ACL de gestión, firewall central y host BKP",
      "reason": "Copias al repositorio mediante su API autenticada."
    },
    {
      "id": "ALLOW-NOC-HYPERVISOR",
      "action": "allow",
      "from": "10.80.0.10",
      "to": "Hosts 10.80.0.11 y 10.80.0.12",
      "service": "TCP 8006",
      "control": "Firewall de hipervisores y gestión",
      "reason": "Administración del clúster solo desde el bastión NOC."
    },
    {
      "id": "ALLOW-LOCAL-ICMP",
      "action": "allow",
      "from": "Usuarios de la misma sede",
      "to": "Usuarios de la misma sede",
      "service": "ICMP",
      "control": "Acceso local / ACL de SVI",
      "reason": "Diagnóstico local entre puestos de la sede."
    },
    {
      "id": "LAB-ICMP-HOST-PAIR",
      "action": "allow",
      "from": "Par de diagnóstico autorizado",
      "to": "Host exacto autorizado",
      "service": "ICMP",
      "control": "ACL de acceso y firewall central",
      "reason": "Excepción temporal limitada a dos IP activas."
    },
    {
      "id": "ALLOW-APP-DATABASE",
      "action": "allow",
      "from": "10.70.200.10",
      "to": "10.70.200.11",
      "service": "TCP 5432",
      "control": "Firewall de los hosts APP y BD",
      "reason": "Solo el servidor de aplicación consulta PostgreSQL."
    },
    {
      "id": "ALLOW-USERS-APP",
      "action": "allow",
      "from": "Usuarios VLAN 10 y 110",
      "to": "10.70.200.10",
      "service": "TCP 443",
      "control": "ACL de acceso y firewall central",
      "reason": "Acceso de los colaboradores a la aplicación financiera por HTTPS."
    },
    {
      "id": "ALLOW-VOICE-PBX",
      "action": "allow",
      "from": "Voz VLAN 20 y 120",
      "to": "10.70.200.20",
      "service": "TCP 5061",
      "control": "ACL de acceso y firewall central",
      "reason": "Señalización SIP sobre TLS hacia la central telefónica."
    },
    {
      "id": "ALLOW-VOICE-RTP",
      "action": "allow",
      "from": "Voz VLAN 20 y 120",
      "to": "10.70.200.20",
      "service": "UDP 10000–20000",
      "control": "ACL de acceso y firewall central",
      "reason": "Audio con medios anclados en la PBX, sin voz directa entre sedes."
    },
    {
      "id": "ALLOW-PBX-RTP",
      "action": "allow",
      "from": "10.70.200.20",
      "to": "Voz VLAN 20 y 120",
      "service": "UDP 10000–20000",
      "control": "Firewall central y ACL de voz",
      "reason": "Audio desde la PBX hacia el rango de medios de los teléfonos."
    },
    {
      "id": "ALLOW-CORP-DNS",
      "action": "allow",
      "from": "Usuarios, voz, gestión y servidores",
      "to": "10.70.200.30",
      "service": "UDP/TCP 53",
      "control": "ACL de acceso y firewall central",
      "reason": "Resolución de nombres a través del DNS corporativo."
    },
    {
      "id": "ALLOW-CORP-NTP",
      "action": "allow",
      "from": "Usuarios, voz, gestión y servidores",
      "to": "10.70.200.30",
      "service": "UDP 123",
      "control": "ACL de acceso y firewall central",
      "reason": "Sincronización horaria con el servicio central."
    },
    {
      "id": "ALLOW-MGMT-AAA",
      "action": "allow",
      "from": "Gestión VLAN 130",
      "to": "10.70.200.31",
      "service": "TCP 49 / UDP 1812–1813",
      "control": "ACL de gestión y firewall central",
      "reason": "TACACS+ de administración y RADIUS de acceso Wi-Fi desde los equipos de red."
    },
    {
      "id": "ALLOW-ADMIN-MGMT",
      "action": "allow",
      "from": "10.80.0.10 (bastión NOC)",
      "to": "Redes de gestión VLAN 130",
      "service": "TCP 22/443 e ICMP",
      "control": "ACL de gestión y firewall central",
      "reason": "Administración remota desde el bastión autorizado del NOC."
    },
    {
      "id": "ALLOW-NMS-MGMT",
      "action": "allow",
      "from": "10.70.200.40",
      "to": "Redes de gestión VLAN 130",
      "service": "UDP 161 e ICMP",
      "control": "ACL de gestión y firewall central",
      "reason": "Monitoreo de equipos desde NMS. SNMPv3 con autenticación y cifrado."
    },
    {
      "id": "ALLOW-MGMT-LOGS",
      "action": "allow",
      "from": "Gestión VLAN 130",
      "to": "10.70.200.40",
      "service": "TCP 6514 / UDP 162",
      "control": "ACL de gestión y firewall central",
      "reason": "Syslog TLS y notificaciones SNMPv3 al colector central."
    },
    {
      "id": "ALLOW-GUEST-DNS",
      "action": "allow",
      "from": "Invitados VLAN 40",
      "to": "1.1.1.1 / 9.9.9.9",
      "service": "UDP/TCP 53",
      "control": "ACL de invitados y firewall central",
      "reason": "DNS de invitados mediante resolutores públicos definidos."
    },
    {
      "id": "DENY-GUEST-PRIVATE",
      "action": "deny",
      "from": "Invitados VLAN 40",
      "to": "Redes privadas e internas",
      "service": "Cualquiera",
      "control": "ACL de invitados y firewall central",
      "reason": "Los invitados no acceden a aplicaciones, voz, servidores ni gestión corporativa."
    },
    {
      "id": "ALLOW-USERS-WEB",
      "action": "allow",
      "from": "Usuarios VLAN 10 y 110",
      "to": "Internet público",
      "service": "TCP 80/443",
      "control": "ACL de acceso y firewall central",
      "reason": "Navegación mediante la salida central y sus controles de seguridad."
    },
    {
      "id": "ALLOW-GUEST-WEB",
      "action": "allow",
      "from": "Invitados VLAN 40",
      "to": "Internet público",
      "service": "TCP 80/443",
      "control": "ACL de invitados y firewall central",
      "reason": "Navegación de invitados con salida central."
    },
    {
      "id": "DENY-USERS-DATABASE",
      "action": "deny",
      "from": "Usuarios VLAN 10 y 110",
      "to": "10.70.200.11",
      "service": "Cualquiera",
      "control": "ACL de acceso y firewall central",
      "reason": "Los puestos utilizan la aplicación y no conectan directamente a la base de datos."
    },
    {
      "id": "DENY-UNAUTHORIZED-MGMT",
      "action": "deny",
      "from": "Cualquier otro origen",
      "to": "Gestión VLAN 130",
      "service": "Cualquiera",
      "control": "ACL de gestión y firewall central",
      "reason": "Solo el puesto NOC y el NMS pueden iniciar los accesos de gestión definidos."
    },
    {
      "id": "DENY-INTERSITE-ICMP",
      "action": "deny",
      "from": "Usuarios de otra sede",
      "to": "Usuarios",
      "service": "ICMP",
      "control": "ACL de acceso y firewall central",
      "reason": "El diagnóstico entre sedes requiere una excepción explícita."
    },
    {
      "id": "DENY-DEFAULT",
      "action": "deny",
      "from": "Cualquiera",
      "to": "Cualquiera",
      "service": "No autorizado arriba",
      "control": "ACL / firewall según recorrido",
      "reason": "Todo flujo sin permiso explícito queda bloqueado y se registra."
    }
  ],
